# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage
.ruff_cache/

# Engine output (regenerated from config + seed — never commit)
events/day=*/
vega.duckdb

# dbt
metrics/target/
metrics/dbt_packages/
metrics/logs/

# Frontend
frontend/node_modules/
frontend/dist/

# Source papers — copyrighted; keep only Daniel's own notes (notation/, papers/ takeaways), not the sources.
# Global: every PDF in this repo is a source paper, none are deliverables.
*.pdf
paper-library/pdfs/
paper-library/md/
paper-library/DML Export Notion/

# Data (do not vendor real datasets)
data/
*.parquet
!events/.gitkeep

# Quarto docs build output (regenerated by `quarto render docs`)
docs/_site/
docs/.quarto/
.quarto/

# Vercel
.vercel/

# Node (anywhere)
node_modules/

# Scratch / working files (analysis drivers, run logs — never commit).
# NB: scoped so they don't match __init__.py / __main__.py.
*.out
labs/**/_*.py
labs/**/_*.out
labs/**/_*.log
notebooks/_*.out
notebooks/_*.log
**/scratchpad/

# OS / editor
.DS_Store
.idea/
.vscode/
